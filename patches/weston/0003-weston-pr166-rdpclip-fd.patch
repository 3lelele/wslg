+ * ACTION OF CONTRACT, TORT OR OTHERWISE, ARISING FROM, OUT OF OR IN
+ * CONNECTION WITH THE SOFTWARE OR THE USE OR OTHER DEALINGS IN THE
+ * SOFTWARE.
+ */
+
+#include "config.h"
+
+#include <unistd.h>
+
+#include "rdpclip-fd.h"
+
+int
+rdp_clipboard_take_fd(int current_fd, int incoming_fd)
+{
+	if (current_fd != -1) {
+		close(incoming_fd);
+		return current_fd;
+	}
+
+	return incoming_fd;
+}
