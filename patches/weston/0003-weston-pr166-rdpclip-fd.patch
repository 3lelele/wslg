index e7a80cf0..61906bfc 100644
--- a/libweston/backend-rdp/meson.build
+++ b/libweston/backend-rdp/meson.build
@@ -66,6 +66,7 @@ srcs_rdp = [
         'rdp.c',
         'rdpdisp.c',
         'rdpclip.c',
+        'rdpclip-fd.c',
         'rdprail.c',
         'rdprail-window-state.c',
         'rdputil.c',
diff --git a/libweston/backend-rdp/rdpclip-fd.c b/libweston/backend-rdp/rdpclip-fd.c
