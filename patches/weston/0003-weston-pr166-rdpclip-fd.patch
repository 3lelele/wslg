+#ifndef RDPCLIP_FD_H
+#define RDPCLIP_FD_H
+
+/* Takes ownership of incoming_fd. Preserve current_fd when it is active and
+ * close incoming_fd; otherwise return incoming_fd. */
+int
+rdp_clipboard_take_fd(int current_fd, int incoming_fd);
+
