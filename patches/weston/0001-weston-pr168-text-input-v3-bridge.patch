 compositor/text-backend.c         | 733 ++++++++++++++++++++++++++++--
 protocol/meson.build              |   1 +
 tests/text-input-method-test.c    | 356 +++++++++++++++
 tests/text-test.c                 | 397 +++++++++++++++-
 tests/text-test.ini.in            |   5 +
 tests/weston-test-desktop-shell.c |  19 +
 7 files changed, 1463 insertions(+), 50 deletions(-)
 create mode 100644 tests/text-input-method-test.c
 create mode 100644 tests/text-test.ini.in

