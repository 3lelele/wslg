+static void
+text_input_v3_enter(void *data,
+		    struct zwp_text_input_v3 *text_input,
+		    struct wl_surface *surface)
+{
+	struct text_input_state *state = data;
+
+	state->activated++;
+}
+
+static void
+text_input_v3_leave(void *data,
+		    struct zwp_text_input_v3 *text_input,
+		    struct wl_surface *surface)
+{
